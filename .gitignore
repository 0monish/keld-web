# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Local art direction and validation workspace. Original Blender scenes,
# 2K source textures, reference screenshots, test reports and backups remain
# on the creator's Mac; only optimized runtime assets belong in this repo.
/design/
/current.png
/expected.png
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.blend
/*.blend1
/*.blend2

# The active browser hero is hero-physical-v1. Previous scene prototypes
# remain locally available, but must not inflate the public initial commit.
/public/brand/hero-reference-*/
/public/brand/hero/
/public/brand/keld-logo-medium-plus.glb
/public/brand/keld-logo-xl.glb
/public/brand/keld-logo-xl-pbr.glb

# Render/diagnostic artifacts from earlier physical-render investigations.
/public/brand/hero-physical-v1/production/
/public/brand/hero-physical-v1/scene-config.json

# Husky generates these wrappers automatically at install time.
/.husky/_/

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/.turbo/
/.cache/
/.output/
/.vercel/

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.blend1
*.log
*.tmp
*.bak
*.swp
*.swo
*~

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local lint rules build
/lint-rules/dist/
